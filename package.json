{
  "name": "sld-sketch",
  "version": "2.0.0",
  "description": "Turn a site-survey equipment table into a single-line diagram sketch (SVG / DXF).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "import": "node tools/import-xlsx.mjs",
    "golden": "node tools/golden.mjs",
    "golden:update": "UPDATE_GOLDEN=1 node tools/golden.mjs",
    "gen": "node tools/gen-fixtures.mjs",
    "build": "node tools/gen-fixtures.mjs && node tools/build-page.mjs",
    "check": "node tools/gen-fixtures.mjs --check && node tools/build-page.mjs --check && node tools/golden.mjs && node tools/usage-baseline.mjs --check && node tools/proposal-audit.mjs --check",
    "smoke": "node tools/smoke-page.mjs",
    "demo": "node tools/demo-video.mjs",
    "draw": "node src/cli/sld.js draw",
    "baseline": "node tools/usage-baseline.mjs",
    "baseline:check": "node tools/usage-baseline.mjs --check",
    "proposals": "node tools/proposal-audit.mjs",
    "proposals:check": "node tools/proposal-audit.mjs --check",
    "proposals:page": "node tools/proposal-audit.mjs --page"
  },
  "bin": {
    "sld": "src/cli/sld.js"
  },
  "license": "UNLICENSED"
}
